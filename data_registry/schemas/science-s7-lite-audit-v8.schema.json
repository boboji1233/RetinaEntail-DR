{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/science-s7-lite-audit-v8.schema.json",
  "title": "Science S7 RetinaEntail-Lite v8 second-fresh-holdout audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "config_sha256",
    "development_disclosure",
    "source_split",
    "method",
    "training",
    "calibration",
    "fresh_validation",
    "legacy_agreement",
    "ood",
    "preservation",
    "io_audit",
    "resource",
    "gate",
    "hashes",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "8.0.0"},
    "experiment_id": {"const": "S7_RETINAENTAIL_LITE_V8"},
    "status": {"enum": ["READY_FOR_AI_QC", "BLOCKED_AUTOMATED_GATE"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "development_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1_to_v7_observed",
        "independent_replication",
        "second_fresh_primary_validation",
        "final_test_opened"
      ],
      "properties": {
        "v1_to_v7_observed": {"const": true},
        "independent_replication": {"const": false},
        "second_fresh_primary_validation": {"const": true},
        "final_test_opened": {"const": false}
      }
    },
    "source_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_universe",
        "historical_v1_to_v6_sources",
        "v7_observed_validation_sources",
        "role_counts",
        "source_class_counts",
        "selected_record_class_counts",
        "role_overlap",
        "fresh_validation_historical_overlap",
        "fresh_validation_v7_overlap"
      ],
      "properties": {
        "source_universe": {"const": 302},
        "historical_v1_to_v6_sources": {"const": 184},
        "v7_observed_validation_sources": {"const": 19},
        "role_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "MODEL_TRAIN",
            "CONFORMAL_FIT",
            "DEVELOPMENT_VALIDATION",
            "V7_OBSERVED_VALIDATION",
            "LEGACY_AGREEMENT"
          ],
          "properties": {
            "MODEL_TRAIN": {"const": 161},
            "CONFORMAL_FIT": {"const": 33},
            "DEVELOPMENT_VALIDATION": {"const": 20},
            "V7_OBSERVED_VALIDATION": {"const": 19},
            "LEGACY_AGREEMENT": {"const": 69}
          }
        },
        "source_class_counts": {"type": "object"},
        "selected_record_class_counts": {"type": "object"},
        "role_overlap": {"const": 0},
        "fresh_validation_historical_overlap": {"const": 0},
        "fresh_validation_v7_overlap": {"const": 0}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "python_version",
        "torch_version",
        "torchvision_version",
        "architecture",
        "input_side",
        "embedding_dim",
        "total_parameter_count",
        "trainable_parameter_count",
        "pretrained_weights",
        "pretrained_weight_source_url",
        "pretrained_weight_sha256",
        "backbone_frozen",
        "retrieval"
      ],
      "properties": {
        "runtime": {"const": "PYTHON_3_11_TORCH_2_5_1_TORCHVISION_0_20_1_CPU"},
        "python_version": {"const": "3.11"},
        "torch_version": {"const": "2.5.1+cpu"},
        "torchvision_version": {"const": "0.20.1+cpu"},
        "architecture": {
          "const": "TARGET_CONTEXT_128_FROZEN_IMAGENET_RESNET18_CLASS_PROJECTED_32D_V1"
        },
        "input_side": {"const": 128},
        "embedding_dim": {"const": 32},
        "total_parameter_count": {"type": "integer", "minimum": 11000000, "maximum": 12000000},
        "trainable_parameter_count": {"type": "integer", "minimum": 60000, "maximum": 70000},
        "pretrained_weights": {"const": true},
        "pretrained_weight_source_url": {
          "const": "https://download.pytorch.org/models/resnet18-f37072fd.pth"
        },
        "pretrained_weight_sha256": {"$ref": "#/$defs/sha256"},
        "backbone_frozen": {"const": true},
        "retrieval": {"const": "SOURCE_ISOLATED_NEAREST_WITNESS_SAME_CLASS_CONDITION"}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_twin_records",
        "class_counts",
        "epochs",
        "batch_size",
        "learning_rate",
        "weight_decay",
        "initial_loss",
        "final_loss",
        "minimum_loss",
        "finite"
      ],
      "properties": {
        "selected_twin_records": {"const": 266},
        "class_counts": {"type": "object"},
        "epochs": {"const": 40},
        "batch_size": {"const": 32},
        "learning_rate": {"const": 0.001},
        "weight_decay": {"const": 0.0001},
        "initial_loss": {"type": "number", "minimum": 0},
        "final_loss": {"type": "number", "minimum": 0},
        "minimum_loss": {"type": "number", "minimum": 0},
        "finite": {"const": true}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_twin_records", "rows", "thresholds_sha256"],
      "properties": {
        "selected_twin_records": {"const": 118},
        "rows": {"const": 472},
        "thresholds_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fresh_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_twin_records",
        "rows",
        "policy_metrics",
        "cluster_bootstrap",
        "moderate_glare_determinate_coverage_per_class"
      ],
      "properties": {
        "selected_twin_records": {"const": 73},
        "rows": {"const": 292},
        "policy_metrics": {"type": "object"},
        "cluster_bootstrap": {"type": "object"},
        "moderate_glare_determinate_coverage_per_class": {
          "type": "object",
          "additionalProperties": false,
          "required": ["HE", "EX", "MA", "SE"],
          "properties": {
            "HE": {"type": "number", "minimum": 0, "maximum": 1},
            "EX": {"type": "number", "minimum": 0, "maximum": 1},
            "MA": {"type": "number", "minimum": 0, "maximum": 1},
            "SE": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "legacy_agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "agreements",
        "agreement_rate",
        "historical_sources_used_for_model_or_calibration",
        "rows_sha256"
      ],
      "properties": {
        "records": {"const": 96},
        "agreements": {"type": "integer", "minimum": 0, "maximum": 96},
        "agreement_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "historical_sources_used_for_model_or_calibration": {"const": 0},
        "rows_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "out_of_model"],
      "properties": {"records": {"const": 160}, "out_of_model": {"const": 160}}
    },
    "preservation": {"type": "object"},
    "io_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "twin_png_decodes",
        "twin_png_hash_mismatches",
        "glare_replay_checks",
        "glare_replay_mismatches",
        "query_witness_source_collisions",
        "locked_test_root_reads",
        "online_evaluation_reads"
      ],
      "properties": {
        "twin_png_decodes": {"type": "integer", "minimum": 1},
        "twin_png_hash_mismatches": {"const": 0},
        "glare_replay_checks": {"type": "integer", "minimum": 1},
        "glare_replay_mismatches": {"const": 0},
        "query_witness_source_collisions": {"const": 0},
        "locked_test_root_reads": {"const": 0},
        "online_evaluation_reads": {"const": 0}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "gpu_used", "peak_python_tracemalloc_bytes", "silent_resolution_change"],
      "properties": {
        "device": {"const": "CPU"},
        "gpu_used": {"const": false},
        "peak_python_tracemalloc_bytes": {"type": "integer", "minimum": 0},
        "silent_resolution_change": {"const": false}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_validation_fcr",
        "minimum_moderate_coverage_per_class",
        "minimum_legacy_verify_agreement",
        "automated",
        "ai_visual_qc",
        "s7_closed",
        "s8_authorized"
      ],
      "properties": {
        "maximum_validation_fcr": {"const": 0.05},
        "minimum_moderate_coverage_per_class": {"const": 0.05},
        "minimum_legacy_verify_agreement": {"const": 0.5},
        "automated": {"enum": ["PASS", "FAIL"]},
        "ai_visual_qc": {"const": "PENDING"},
        "s7_closed": {"const": false},
        "s8_authorized": {"const": false}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_sha256",
        "model_sha256",
        "roles_sha256",
        "calibration_sha256",
        "results_sha256",
        "contact_sheet_sha256",
        "pretrained_weight_sha256"
      ],
      "properties": {
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "roles_sha256": {"$ref": "#/$defs/sha256"},
        "calibration_sha256": {"$ref": "#/$defs/sha256"},
        "results_sha256": {"$ref": "#/$defs/sha256"},
        "pretrained_weight_sha256": {"$ref": "#/$defs/sha256"},
        "contact_sheet_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["HE", "EX", "MA", "SE"],
          "properties": {
            "HE": {"$ref": "#/$defs/sha256"},
            "EX": {"$ref": "#/$defs/sha256"},
            "MA": {"$ref": "#/$defs/sha256"},
            "SE": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "evidence_boundary": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
