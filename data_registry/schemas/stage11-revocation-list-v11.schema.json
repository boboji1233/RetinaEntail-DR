{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/stage11-revocation-list-v11.schema.json",
  "title": "RetinaEntail-DR Stage 11 Revocation List v11",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature_b64"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "artifact_type", "issuer_key_id", "issued_at_epoch",
        "next_update_epoch", "entries", "scope", "production_revocation_status"
      ],
      "properties": {
        "schema_version": {"const": "11.0.0"},
        "artifact_type": {"const": "REVOCATION_LIST"},
        "issuer_key_id": {"$ref": "#/$defs/sha256"},
        "issued_at_epoch": {"type": "integer", "minimum": 1},
        "next_update_epoch": {"type": "integer", "minimum": 1},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["certificate_serial", "reason", "revoked_at_epoch"],
            "properties": {
              "certificate_serial": {"$ref": "#/$defs/sha256"},
              "reason": {"type": "string", "minLength": 1},
              "revoked_at_epoch": {"type": "integer", "minimum": 1}
            }
          }
        },
        "scope": {"const": "SYNTHETIC_ONLY"},
        "production_revocation_status": {"const": false}
      }
    },
    "signature_b64": {"type": "string", "minLength": 88, "maxLength": 88}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
