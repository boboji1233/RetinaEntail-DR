{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/science-s7-lite-audit-v1.schema.json",
  "title": "Science S7 RetinaEntail-Lite v1 audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "config_sha256",
    "scope",
    "selection",
    "encoder",
    "search",
    "calibration",
    "multi_region",
    "witness",
    "development_gate_metrics",
    "failure_injection_states",
    "resource",
    "io_audit",
    "gate",
    "hashes",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"const": "S7_RETINAENTAIL_LITE_V1"},
    "status": {"enum": ["READY_FOR_AI_QC", "BLOCKED_AUTOMATED_GATE"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["splits", "final_test_status", "paper_performance", "development_fcr_only"],
      "properties": {
        "splits": {"const": ["TRAIN", "CALIBRATION"]},
        "final_test_status": {"const": "NOT_OPENED"},
        "paper_performance": {"const": false},
        "development_fcr_only": {"const": true}
      }
    },
    "selection": {"type": "object"},
    "encoder": {
      "type": "object",
      "required": ["kind", "input_shape", "feature_dimensions", "learned_parameters", "device"],
      "properties": {
        "kind": {"const": "FROZEN_INTERPRETABLE_MULTISCALE_NUMPY_V1"},
        "input_shape": {"const": [32, 32, 3]},
        "feature_dimensions": {"const": 98},
        "learned_parameters": {"const": 0},
        "device": {"const": "CPU"}
      }
    },
    "search": {
      "type": "object",
      "required": ["completed_searches", "finite_zero_gap_searches", "source_leaks", "global_claim"],
      "properties": {
        "completed_searches": {"type": "integer", "minimum": 1},
        "finite_zero_gap_searches": {"type": "integer", "minimum": 1},
        "source_leaks": {"const": 0},
        "global_claim": {"const": "RETRIEVED_FINITE_LITE_HYPOTHESIS_CLASS_ONLY"}
      }
    },
    "calibration": {"type": "object"},
    "multi_region": {"type": "object"},
    "witness": {
      "type": "object",
      "required": ["replay_checks", "replay_passes", "replay_rate", "predicate_checks", "predicate_passes", "predicate_rate"],
      "properties": {
        "replay_checks": {"type": "integer", "minimum": 1},
        "replay_passes": {"type": "integer", "minimum": 0},
        "replay_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "predicate_checks": {"type": "integer", "minimum": 1},
        "predicate_passes": {"type": "integer", "minimum": 0},
        "predicate_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "development_gate_metrics": {"type": "object"},
    "failure_injection_states": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"const": "OUT_OF_MODEL"}
    },
    "resource": {
      "type": "object",
      "required": ["device", "gpu_used", "learned_parameters", "peak_python_tracemalloc_bytes", "wall_seconds", "silent_resolution_change"],
      "properties": {
        "device": {"const": "CPU"},
        "gpu_used": {"const": false},
        "learned_parameters": {"const": 0},
        "peak_python_tracemalloc_bytes": {"type": "integer", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0},
        "silent_resolution_change": {"const": false}
      }
    },
    "io_audit": {
      "type": "object",
      "required": ["locked_test_root_reads", "online_evaluation_reads", "source_split_leaks"],
      "properties": {
        "locked_test_root_reads": {"const": 0},
        "online_evaluation_reads": {"const": 0},
        "source_split_leaks": {"const": 0}
      }
    },
    "gate": {
      "type": "object",
      "required": ["automated", "ai_visual_qc", "s8_authorized"],
      "properties": {
        "automated": {"enum": ["PASS", "FAIL"]},
        "ai_visual_qc": {"const": "PENDING"},
        "s8_authorized": {"const": false}
      }
    },
    "hashes": {
      "type": "object",
      "required": ["code_sha256", "encoder_spec_sha256", "calibration_sha256", "results_sha256"],
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "evidence_boundary": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
