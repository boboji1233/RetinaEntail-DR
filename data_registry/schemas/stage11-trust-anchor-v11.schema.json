{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/stage11-trust-anchor-v11.schema.json",
  "title": "RetinaEntail-DR Stage 11 Synthetic Trust Anchor v11",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature_b64"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "artifact_type", "algorithm", "key_id", "public_key_b64",
        "trust_scope", "not_before_epoch", "not_after_epoch",
        "fixture_private_derivation_public", "production_authentication"
      ],
      "properties": {
        "schema_version": {"const": "11.0.0"},
        "artifact_type": {"const": "TRUST_ANCHOR"},
        "algorithm": {"const": "Ed25519"},
        "key_id": {"$ref": "#/$defs/sha256"},
        "public_key_b64": {"type": "string", "minLength": 44, "maxLength": 44},
        "trust_scope": {"const": "SYNTHETIC_FIXTURE_TRUST_ANCHOR"},
        "not_before_epoch": {"type": "integer", "minimum": 1},
        "not_after_epoch": {"type": "integer", "minimum": 1},
        "fixture_private_derivation_public": {"const": true},
        "production_authentication": {"const": false}
      }
    },
    "signature_b64": {"type": "string", "minLength": 88, "maxLength": 88}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
