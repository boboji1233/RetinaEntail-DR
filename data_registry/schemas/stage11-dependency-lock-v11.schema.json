{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/stage11-dependency-lock-v11.schema.json",
  "title": "RetinaEntail-DR Stage 11 Installed Dependency Evidence v11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "lock_kind", "entries", "complete_wheel_archive_hashes",
    "production_cross_host_ready", "contains_install_paths", "contains_credentials",
    "lock_sha256"
  ],
  "properties": {
    "schema_version": {"const": "11.0.0"},
    "lock_kind": {"const": "installed-distribution-metadata-v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "version", "metadata_sha256", "record_sha256",
          "installed_file_count", "wheel_archive_sha256"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "metadata_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "record_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "installed_file_count": {"type": "integer", "minimum": 0},
          "wheel_archive_sha256": {"type": "null"}
        }
      }
    },
    "complete_wheel_archive_hashes": {"const": false},
    "production_cross_host_ready": {"const": false},
    "contains_install_paths": {"const": false},
    "contains_credentials": {"const": false},
    "lock_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
