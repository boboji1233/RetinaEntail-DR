{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/science-s7-fgadr-target-manifest-v1.schema.json",
  "title": "Science S7 FGADR deterministic target manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "status", "source_order", "class_order", "component_connectivity", "component_order", "maximum_targets_per_source_class", "accepted_count", "rejected_count", "accepted", "rejected", "downstream_authorization"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"const": "S7_P1_FGADR_IDENTITY_AND_TARGET_MANIFEST_V1"},
    "status": {"const": "FROZEN_DETERMINISTIC_TARGET_MEMBERSHIP"},
    "source_order": {"const": "SHA256_OFFICIAL_SOURCE_ID_ASC"},
    "class_order": {"const": ["HE", "EX", "MA", "SE"]},
    "component_connectivity": {"const": 8},
    "component_order": {"const": "SHA256_CLASS_SOURCE_COMPONENT_GEOMETRY_ASC"},
    "maximum_targets_per_source_class": {"const": 1},
    "accepted_count": {"type": "integer", "minimum": 0},
    "rejected_count": {"type": "integer", "minimum": 0},
    "accepted": {"type": "array", "items": {"type": "object"}},
    "rejected": {"type": "array", "items": {"type": "object"}},
    "downstream_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlled_twin_generation", "model_execution", "fcr_estimation", "science_s8", "final_locked_test"],
      "properties": {
        "controlled_twin_generation": {"const": false},
        "model_execution": {"const": false},
        "fcr_estimation": {"const": false},
        "science_s8": {"const": false},
        "final_locked_test": {"const": false}
      }
    }
  }
}
