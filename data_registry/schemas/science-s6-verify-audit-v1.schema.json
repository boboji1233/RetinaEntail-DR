{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/science-s6-verify-audit-v1.schema.json",
  "title": "Science S6 RetinaEntail-Verify v1 audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "config_sha256",
    "scope",
    "selection",
    "solver",
    "witness",
    "development_diagnostics",
    "io_audit",
    "gate",
    "hashes",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"const": "S6_RETINAENTAIL_VERIFY_V1"},
    "status": {"enum": ["READY_FOR_AI_QC", "BLOCKED_AUTOMATED_GATE"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["splits", "final_test_status", "oracle_region_only", "paper_performance"],
      "properties": {
        "splits": {"const": ["TRAIN", "CALIBRATION"]},
        "final_test_status": {"const": "NOT_OPENED"},
        "oracle_region_only": {"const": true},
        "paper_performance": {"const": false}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regions_per_class",
        "strata_per_class",
        "bank_entries_per_class",
        "bank_probe_source_isolation",
        "unique_region_gate"
      ],
      "properties": {
        "regions_per_class": {"$ref": "#/$defs/classIntegerMap"},
        "strata_per_class": {
          "type": "object",
          "additionalProperties": false,
          "required": ["HE", "EX", "MA", "SE"],
          "properties": {
            "HE": {"$ref": "#/$defs/strataMap"},
            "EX": {"$ref": "#/$defs/strataMap"},
            "MA": {"$ref": "#/$defs/strataMap"},
            "SE": {"$ref": "#/$defs/strataMap"}
          }
        },
        "bank_entries_per_class": {"$ref": "#/$defs/classIntegerMap"},
        "bank_probe_source_isolation": {"type": "boolean"},
        "unique_region_gate": {"type": "boolean"}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "global_claim",
        "completed_searches",
        "finite_zero_gap_searches",
        "failure_injection_states"
      ],
      "properties": {
        "strategy": {"const": "EXHAUSTIVE_RETRIEVED_FINITE_GRID"},
        "global_claim": {"const": "RETRIEVED_FINITE_HYPOTHESIS_CLASS_ONLY"},
        "completed_searches": {"type": "integer", "minimum": 0},
        "finite_zero_gap_searches": {"type": "integer", "minimum": 0},
        "failure_injection_states": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missing_threshold",
            "nonfinite_score",
            "unknown_degradation",
            "failed_solver",
            "missing_feasibility"
          ],
          "properties": {
            "missing_threshold": {"const": "OUT_OF_MODEL"},
            "nonfinite_score": {"const": "OUT_OF_MODEL"},
            "unknown_degradation": {"const": "OUT_OF_MODEL"},
            "failed_solver": {"const": "OUT_OF_MODEL"},
            "missing_feasibility": {"const": "OUT_OF_MODEL"}
          }
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_checks",
        "replay_passes",
        "replay_rate",
        "predicate_checks",
        "predicate_passes",
        "predicate_validity_rate"
      ],
      "properties": {
        "replay_checks": {"type": "integer", "minimum": 0},
        "replay_passes": {"type": "integer", "minimum": 0},
        "replay_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "predicate_checks": {"type": "integer", "minimum": 0},
        "predicate_passes": {"type": "integer", "minimum": 0},
        "predicate_validity_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "development_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_counts_per_class",
        "s5_tier_a_ambiguous_cases",
        "s5_tier_a_raw_unidentifiable",
        "s5_tier_a_ambiguity_agreement_rate",
        "disposition"
      ],
      "properties": {
        "state_counts_per_class": {
          "type": "object",
          "additionalProperties": false,
          "required": ["HE", "EX", "MA", "SE"],
          "properties": {
            "HE": {"$ref": "#/$defs/stateMap"},
            "EX": {"$ref": "#/$defs/stateMap"},
            "MA": {"$ref": "#/$defs/stateMap"},
            "SE": {"$ref": "#/$defs/stateMap"}
          }
        },
        "s5_tier_a_ambiguous_cases": {"type": "integer", "minimum": 0},
        "s5_tier_a_raw_unidentifiable": {"type": "integer", "minimum": 0},
        "s5_tier_a_ambiguity_agreement_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "disposition": {"const": "DEVELOPMENT_DIAGNOSTIC_NOT_FCR_OR_PAPER_PERFORMANCE"}
      }
    },
    "io_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s4_twin_png_decodes",
        "s5_witness_png_decodes",
        "witness_replay_png_decodes",
        "locked_test_root_reads",
        "online_evaluation_reads",
        "uwf_reads",
        "dr_grade_values_used",
        "source_split_leaks"
      ],
      "properties": {
        "s4_twin_png_decodes": {"type": "integer", "minimum": 0},
        "s5_witness_png_decodes": {"type": "integer", "minimum": 0},
        "witness_replay_png_decodes": {"type": "integer", "minimum": 0},
        "locked_test_root_reads": {"const": 0},
        "online_evaluation_reads": {"const": 0},
        "uwf_reads": {"const": 0},
        "dr_grade_values_used": {"const": 0},
        "source_split_leaks": {"const": 0}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated", "ai_visual_qc", "s7_authorized"],
      "properties": {
        "automated": {"enum": ["PASS", "FAIL"]},
        "ai_visual_qc": {"const": "PENDING"},
        "s7_authorized": {"const": false}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_sha256",
        "exemplar_bank_sha256",
        "threshold_calibration_sha256",
        "verify_results_sha256"
      ],
      "properties": {
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "exemplar_bank_sha256": {"$ref": "#/$defs/sha256"},
        "threshold_calibration_sha256": {"$ref": "#/$defs/sha256"},
        "verify_results_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_boundary": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classIntegerMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HE", "EX", "MA", "SE"],
      "properties": {
        "HE": {"type": "integer", "minimum": 0},
        "EX": {"type": "integer", "minimum": 0},
        "MA": {"type": "integer", "minimum": 0},
        "SE": {"type": "integer", "minimum": 0}
      }
    },
    "strataMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PRESENT_ID", "ABSENT_ID", "S5_TIER_A_AMBIGUOUS_ID", "NEAR_OOD", "FAR_OOD"],
      "properties": {
        "PRESENT_ID": {"type": "integer", "minimum": 0},
        "ABSENT_ID": {"type": "integer", "minimum": 0},
        "S5_TIER_A_AMBIGUOUS_ID": {"type": "integer", "minimum": 0},
        "NEAR_OOD": {"type": "integer", "minimum": 0},
        "FAR_OOD": {"type": "integer", "minimum": 0}
      }
    },
    "stateMap": {
      "type": "object",
      "propertyNames": {
        "enum": ["ENTAILED_PRESENT", "ENTAILED_ABSENT", "RAW_UNIDENTIFIABLE", "OUT_OF_MODEL"]
      },
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
