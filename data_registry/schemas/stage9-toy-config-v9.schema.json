{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/stage9-toy-config-v9.schema.json",
  "title": "RetinaEntail-DR Stage 9 Synthetic Independent-Session Config v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "method", "scope", "source_contract", "dataset_id",
    "dataset_version", "split", "session_count", "environment_lock", "inclusion_case_ids",
    "replay_runs", "degradation_replay_set_sha256", "locked_contract", "confidence_level",
    "locked_policy"
  ],
  "properties": {
    "schema_version": {"const": "9.0"},
    "run_id": {"const": "stage9-toy-independent-session-diff-001"},
    "method": {"const": "independent_process_stage8_package_diff_v1"},
    "scope": {"const": "SYNTHETIC_FIXTURE"},
    "source_contract": {"$ref": "#/$defs/sourceContract"},
    "dataset_id": {"const": "synthetic_stage2"},
    "dataset_version": {"const": "synthetic-fixture-v1"},
    "split": {"const": "test"},
    "session_count": {"const": 2},
    "environment_lock": {"$ref": "#/$defs/environmentLock"},
    "inclusion_case_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "replay_runs": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"$ref": "#/$defs/replayRun"}
    },
    "degradation_replay_set_sha256": {"$ref": "#/$defs/sha256"},
    "locked_contract": {"$ref": "#/$defs/lockedContract"},
    "confidence_level": {"const": 0.95},
    "locked_policy": {"$ref": "#/$defs/lockedPolicy"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u0000]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveCount": {"type": "integer", "minimum": 1},
    "sourceContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "stage8_package_sha256", "stage8_package_file_count", "stage7_package_sha256",
        "stage8_preregistration_sha256"
      ],
      "properties": {
        "stage8_package_sha256": {"$ref": "#/$defs/sha256"},
        "stage8_package_file_count": {"$ref": "#/$defs/positiveCount"},
        "stage7_package_sha256": {"$ref": "#/$defs/sha256"},
        "stage8_preregistration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environmentLock": {
      "type": "object", "additionalProperties": false,
      "required": ["capture_before_sessions", "python_hash_seed"],
      "properties": {
        "capture_before_sessions": {"const": true},
        "python_hash_seed": {"const": "0"}
      }
    },
    "replayRun": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "seed"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "lockedContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "alpha", "positive_threshold", "negative_threshold", "positive_sample_count",
        "negative_sample_count", "config_hash", "data_hash", "model_hash"
      ],
      "properties": {
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "positive_threshold": {"type": "number", "minimum": 0},
        "negative_threshold": {"type": "number", "minimum": 0},
        "positive_sample_count": {"$ref": "#/$defs/positiveCount"},
        "negative_sample_count": {"$ref": "#/$defs/positiveCount"},
        "config_hash": {"$ref": "#/$defs/sha256"},
        "data_hash": {"$ref": "#/$defs/sha256"},
        "model_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "lockedPolicy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "test_tuning_prohibited", "threshold_reestimation_prohibited",
        "sample_replacement_prohibited", "network_used", "gpu_used", "real_data_access",
        "deterministic_difference_fail_closed", "detached_receipt_authoritative"
      ],
      "properties": {
        "test_tuning_prohibited": {"const": true},
        "threshold_reestimation_prohibited": {"const": true},
        "sample_replacement_prohibited": {"const": true},
        "network_used": {"const": false},
        "gpu_used": {"const": false},
        "real_data_access": {"const": false},
        "deterministic_difference_fail_closed": {"const": true},
        "detached_receipt_authoritative": {"const": false}
      }
    }
  }
}
