{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.invalid/schemas/dataset-registry-1.0.0.json",
  "title": "RetinaEntail-DR dataset registry entry",
  "description": "Metadata-only registry schema. Validation does not grant data-use rights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "name",
    "version",
    "source_url",
    "alternate_source_urls",
    "access_mode",
    "license_status",
    "license_review_status",
    "license_notes",
    "expected_labels",
    "label_verification_status",
    "root_env",
    "patient_id_available",
    "source_image_id_rule",
    "redistribution"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "alternate_source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      },
      "uniqueItems": true
    },
    "access_mode": {
      "enum": [
        "manual",
        "public_direct",
        "gated"
      ]
    },
    "license_status": {
      "description": "Legal/data-license assessment, independent of code-repository licensing.",
      "enum": [
        "unknown",
        "ambiguous",
        "verified",
        "restricted"
      ]
    },
    "license_review_status": {
      "enum": [
        "pending_review",
        "reviewed"
      ]
    },
    "license_notes": {
      "type": "string",
      "minLength": 1
    },
    "expected_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "label_verification_status": {
      "enum": [
        "pending_review",
        "verified"
      ]
    },
    "root_env": {
      "type": "string",
      "pattern": "^RETINAENTAIL_[A-Z0-9_]+_ROOT$"
    },
    "patient_id_available": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "source_image_id_rule": {
      "type": "string",
      "minLength": 1
    },
    "redistribution": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset_id": {
            "enum": [
              "real_fundus"
            ]
          }
        },
        "required": [
          "dataset_id"
        ]
      },
      "then": {
        "properties": {
          "license_status": {
            "const": "ambiguous"
          },
          "license_review_status": {
            "const": "pending_review"
          }
        }
      }
    }
  ]
}
