{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/science-s7-lite-audit-v5.schema.json",
  "title": "Science S7 RetinaEntail-Lite v5 audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "config_sha256",
    "development_disclosure",
    "method",
    "preservation",
    "calibration",
    "multi_region",
    "development_gate_metrics",
    "io_audit",
    "gate",
    "hashes",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "5.0.0"},
    "experiment_id": {"const": "S7_RETINAENTAIL_LITE_V5"},
    "status": {"enum": ["READY_FOR_AI_QC", "BLOCKED_AUTOMATED_GATE"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "development_disclosure": {
      "type": "object",
      "properties": {
        "v1_v2_v3_v4_observed": {"const": true},
        "independent_replication": {"const": false},
        "final_test_opened": {"const": false}
      }
    },
    "method": {
      "type": "object",
      "required": ["search_policy", "geometry", "feature", "feature_dimensions"],
      "properties": {
        "search_policy": {"const": "REUSE_V1_IMMUTABLE_BEST_WITNESSES"},
        "geometry": {"const": "QUERY_AND_ANCHOR_TARGET_BBOX_INDEPENDENT_ALIGNMENT"},
        "feature": {"const": "RGB_GREEN_GRADIENT_LOCAL_RESIDUAL_V1"},
        "feature_dimensions": {"const": 1280}
      }
    },
    "preservation": {"type": "object"},
    "calibration": {"type": "object"},
    "multi_region": {"type": "object"},
    "development_gate_metrics": {"type": "object"},
    "io_audit": {
      "type": "object",
      "required": ["bound_png_decodes", "probe_searches_rerun", "locked_test_root_reads", "online_evaluation_reads", "source_split_leaks"],
      "properties": {
        "bound_png_decodes": {"const": 1200},
        "probe_searches_rerun": {"const": 0},
        "locked_test_root_reads": {"const": 0},
        "online_evaluation_reads": {"const": 0},
        "source_split_leaks": {"const": 0}
      }
    },
    "gate": {
      "type": "object",
      "required": ["automated", "ai_visual_qc", "s8_authorized"],
      "properties": {
        "automated": {"enum": ["PASS", "FAIL"]},
        "ai_visual_qc": {"const": "PENDING"},
        "s8_authorized": {"const": false}
      }
    },
    "hashes": {
      "type": "object",
      "required": ["code_sha256", "calibration_sha256", "results_sha256"],
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "evidence_boundary": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
