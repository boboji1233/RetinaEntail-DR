{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/science-s7-lite-audit-v3.schema.json",
  "title": "Science S7 RetinaEntail-Lite v3 audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "config_sha256",
    "development_disclosure",
    "method",
    "preservation",
    "calibration",
    "multi_region",
    "development_gate_metrics",
    "resource",
    "io_audit",
    "gate",
    "hashes",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "experiment_id": {"const": "S7_RETINAENTAIL_LITE_V3"},
    "status": {"enum": ["READY_FOR_AI_QC", "BLOCKED_AUTOMATED_GATE"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "development_disclosure": {
      "type": "object",
      "required": ["v1_observed", "v2_observed", "independent_replication", "final_test_opened"],
      "properties": {
        "v1_observed": {"const": true},
        "v2_observed": {"const": true},
        "independent_replication": {"const": false},
        "final_test_opened": {"const": false}
      }
    },
    "method": {
      "type": "object",
      "required": ["encoder", "feature_dimensions", "head", "calibration_fit", "calibration_rows", "probe_searches_rerun", "probe_truth_used_for_training"],
      "properties": {
        "encoder": {"const": "FROZEN_LESION_CORE_MULTISCALE_NUMPY_V2"},
        "feature_dimensions": {"const": 323},
        "head": {"const": "PAIRED_DIAGONAL_LDA_PROTOTYPE"},
        "calibration_fit": {"const": "LEAVE_ONE_SOURCE_OUT"},
        "calibration_rows": {"const": 768},
        "probe_searches_rerun": {"const": 0},
        "probe_truth_used_for_training": {"const": false}
      }
    },
    "preservation": {"type": "object"},
    "calibration": {"type": "object"},
    "multi_region": {"type": "object"},
    "development_gate_metrics": {"type": "object"},
    "resource": {"type": "object"},
    "io_audit": {
      "type": "object",
      "required": ["probe_observation_decodes", "probe_searches_rerun", "locked_test_root_reads", "online_evaluation_reads", "source_split_leaks"],
      "properties": {
        "probe_observation_decodes": {"const": 400},
        "probe_searches_rerun": {"const": 0},
        "locked_test_root_reads": {"const": 0},
        "online_evaluation_reads": {"const": 0},
        "source_split_leaks": {"const": 0}
      }
    },
    "gate": {
      "type": "object",
      "required": ["automated", "ai_visual_qc", "s8_authorized"],
      "properties": {
        "automated": {"enum": ["PASS", "FAIL"]},
        "ai_visual_qc": {"const": "PENDING"},
        "s8_authorized": {"const": false}
      }
    },
    "hashes": {
      "type": "object",
      "required": ["code_sha256", "calibration_sha256", "results_sha256"],
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "evidence_boundary": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
