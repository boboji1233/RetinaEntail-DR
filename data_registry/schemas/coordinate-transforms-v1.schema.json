{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/coordinate-transforms-v1.schema.json",
  "title": "RetinaEntail-DR Science S2 coordinate transforms",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scope": {"const": "TRAIN_AND_CALIBRATION_ONLY"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "source_image_id", "split", "image_size_wh", "fov"],
        "properties": {
          "schema_version": {"const": "1.0.0"},
          "split": {"enum": ["TRAIN", "CALIBRATION"]},
          "image_size_wh": {
            "type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}],
            "minItems": 2, "maxItems": 2
          },
          "fov": {
            "type": "object",
            "required": [
              "schema_version", "rule_version", "bbox_xyxy", "crop_size_wh",
              "original_to_crop", "crop_to_original", "boundary_model"
            ]
          }
        }
      }
    }
  }
}
