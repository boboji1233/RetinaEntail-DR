{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/stage11-signed-envelope-v11.schema.json",
  "title": "RetinaEntail-DR Stage 11 Ed25519 Envelope v11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "algorithm", "authentication_scope", "certificate_serial",
    "key_id", "payload", "signature_b64"
  ],
  "properties": {
    "schema_version": {"const": "11.0.0"},
    "algorithm": {"const": "Ed25519"},
    "authentication_scope": {"const": "LOCAL_ASYMMETRIC_FIXTURE_ONLY"},
    "certificate_serial": {"$ref": "#/$defs/sha256"},
    "key_id": {"$ref": "#/$defs/sha256"},
    "payload": {
      "type": "object",
      "required": [
        "schema_version", "runner_id", "logical_host_id", "producer_process_id",
        "session_nonce_sha256", "dataset_id", "dataset_version", "scope", "split",
        "source_stage10_package_sha256", "source_stage10_package_file_count",
        "stage10_manifest_sha256", "stage10_audit_sha256", "stage10_summary_sha256",
        "stage10_environment_lock_sha256", "baseline_projection_sha256",
        "runtime_lock_sha256", "dependency_lock_sha256", "trust_anchor_sha256",
        "host_profile_sha256", "alpha", "positive_threshold", "negative_threshold",
        "positive_sample_count", "negative_sample_count", "config_hash", "data_hash",
        "model_hash",
        "payload_contains_data", "payload_contains_root", "payload_contains_private_key",
        "authorizes_real_data", "authorizes_physical_root",
        "detached_envelope_authoritative", "physical_host_count",
        "cross_physical_host_claim", "production_authentication"
      ],
      "properties": {
        "schema_version": {"const": "11.0.0"},
        "runner_id": {"type": "string", "minLength": 1},
        "logical_host_id": {"type": "string", "minLength": 1},
        "producer_process_id": {"type": "integer", "minimum": 1},
        "session_nonce_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "scope": {"const": "SYNTHETIC_ONLY"},
        "split": {"const": "test"},
        "source_stage10_package_sha256": {"$ref": "#/$defs/sha256"},
        "source_stage10_package_file_count": {"type": "integer", "minimum": 1},
        "stage10_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "stage10_audit_sha256": {"$ref": "#/$defs/sha256"},
        "stage10_summary_sha256": {"$ref": "#/$defs/sha256"},
        "stage10_environment_lock_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_projection_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_lock_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "trust_anchor_sha256": {"$ref": "#/$defs/sha256"},
        "host_profile_sha256": {"$ref": "#/$defs/sha256"},
        "alpha": {"type": "number"},
        "positive_threshold": {"type": "number"},
        "negative_threshold": {"type": "number"},
        "positive_sample_count": {"type": "integer", "minimum": 1},
        "negative_sample_count": {"type": "integer", "minimum": 1},
        "config_hash": {"$ref": "#/$defs/sha256"},
        "data_hash": {"$ref": "#/$defs/sha256"},
        "model_hash": {"$ref": "#/$defs/sha256"},
        "payload_contains_data": {"const": false},
        "payload_contains_root": {"const": false},
        "payload_contains_private_key": {"const": false},
        "authorizes_real_data": {"const": false},
        "authorizes_physical_root": {"const": false},
        "detached_envelope_authoritative": {"const": false},
        "physical_host_count": {"const": 1},
        "cross_physical_host_claim": {"const": false},
        "production_authentication": {"const": false}
      },
      "additionalProperties": false
    },
    "signature_b64": {"type": "string", "minLength": 88, "maxLength": 88}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
