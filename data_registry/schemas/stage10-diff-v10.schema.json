{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/stage10-diff-v10.schema.json",
  "title": "RetinaEntail-DR Stage 10 Cross-Runner Exact Diff v10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "clinical_claim", "cross_physical_host_claim",
    "deterministic_difference_fail_closed", "confidence_level", "runner_a", "runner_b",
    "independent_runner_processes", "independent_runner_sessions", "distinct_runner_ids",
    "global_differences", "comparison_count", "case_comparisons", "transition_matrix",
    "metric_intervals", "deterministic_file_mismatch_count",
    "allowed_provenance_difference_count"
  ],
  "properties": {
    "schema_version": {"const": "10.0.0"},
    "status": {"enum": ["SUCCESS", "FAIL_CLOSED"]},
    "clinical_claim": {"const": false},
    "cross_physical_host_claim": {"const": false},
    "deterministic_difference_fail_closed": {"const": true},
    "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "runner_a": {"$ref": "#/$defs/runner"},
    "runner_b": {"$ref": "#/$defs/runner"},
    "independent_runner_processes": {"type": "boolean"},
    "independent_runner_sessions": {"type": "boolean"},
    "distinct_runner_ids": {"type": "boolean"},
    "global_differences": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/difference"}},
    "comparison_count": {"type": "integer", "minimum": 0},
    "case_comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
    "transition_matrix": {
      "type": "object", "additionalProperties": false, "minProperties": 16, "maxProperties": 16,
      "patternProperties": {
        "^(ENTAILED_PRESENT|ENTAILED_ABSENT|RAW_UNIDENTIFIABLE|OUT_OF_MODEL)->(ENTAILED_PRESENT|ENTAILED_ABSENT|RAW_UNIDENTIFIABLE|OUT_OF_MODEL)$": {"type": "integer", "minimum": 0}
      }
    },
    "metric_intervals": {
      "type": "object", "additionalProperties": false,
      "required": [
        "state_exact_match", "score_exact_match", "fail_closed_ood_exact_match",
        "dual_witness_content_exact_match", "dual_witness_replay_result_exact_match",
        "full_deterministic_record_exact_match"
      ],
      "properties": {
        "state_exact_match": {"$ref": "#/$defs/interval"},
        "score_exact_match": {"$ref": "#/$defs/interval"},
        "fail_closed_ood_exact_match": {"$ref": "#/$defs/interval"},
        "dual_witness_content_exact_match": {"$ref": "#/$defs/interval"},
        "dual_witness_replay_result_exact_match": {"$ref": "#/$defs/interval"},
        "full_deterministic_record_exact_match": {"$ref": "#/$defs/interval"}
      }
    },
    "deterministic_file_mismatch_count": {"type": "integer", "minimum": 0},
    "allowed_provenance_difference_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u0000]+$"},
    "state": {"enum": ["ENTAILED_PRESENT", "ENTAILED_ABSENT", "RAW_UNIDENTIFIABLE", "OUT_OF_MODEL"]},
    "difference": {"enum": [
      "ENVIRONMENT_LOCK", "DATASET_IDENTITY", "SCOPE_OR_SPLIT", "PREREGISTRATION",
      "SOURCE_STAGE9_PACKAGE", "SOURCE_PROVENANCE", "SIGNATURE", "RUNNER_INDEPENDENCE",
      "DETERMINISTIC_PACKAGE_CONTENT", "OBSERVATION_SET", "STATE", "SCORE",
      "FAIL_CLOSED_OR_OOD", "WITNESS_CONTENT", "WITNESS_REPLAY", "OBSERVATION_RECORD"
    ]},
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "runner_id", "producer_process_id", "session_nonce_sha256",
        "environment_lock_sha256", "host_profile_sha256", "dataset_id", "dataset_version",
        "scope", "split", "source_stage9_package_sha256", "stage9_package_sha256",
        "stage9_package_file_count", "stage9_manifest_sha256", "stage9_audit_sha256",
        "stage9_preregistration_sha256", "source_stage7_package_sha256",
        "source_stage8_package_sha256", "deterministic_projection_sha256", "envelope_sha256",
        "signature_verified", "complete_stage9_package_replay_verified", "detached_receipt_authoritative"
      ],
      "properties": {
        "schema_version": {"const": "10.0.0"},
        "runner_id": {"$ref": "#/$defs/identifier"},
        "producer_process_id": {"type": "integer", "minimum": 1},
        "session_nonce_sha256": {"$ref": "#/$defs/sha256"},
        "environment_lock_sha256": {"$ref": "#/$defs/sha256"},
        "host_profile_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_id": {"$ref": "#/$defs/identifier"},
        "dataset_version": {"$ref": "#/$defs/identifier"},
        "scope": {"enum": ["SYNTHETIC_ONLY", "APPROVED_REAL_DATA"]},
        "split": {"const": "test"},
        "source_stage9_package_sha256": {"$ref": "#/$defs/sha256"},
        "stage9_package_sha256": {"$ref": "#/$defs/sha256"},
        "stage9_package_file_count": {"type": "integer", "minimum": 1},
        "stage9_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "stage9_audit_sha256": {"$ref": "#/$defs/sha256"},
        "stage9_preregistration_sha256": {"$ref": "#/$defs/sha256"},
        "source_stage7_package_sha256": {"$ref": "#/$defs/sha256"},
        "source_stage8_package_sha256": {"$ref": "#/$defs/sha256"},
        "deterministic_projection_sha256": {"$ref": "#/$defs/sha256"},
        "envelope_sha256": {"$ref": "#/$defs/sha256"},
        "signature_verified": {"const": true},
        "complete_stage9_package_replay_verified": {"const": true},
        "detached_receipt_authoritative": {"const": false}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "case_id", "run_id", "runner_a_state", "runner_b_state",
        "effective_state", "runner_a_positive_score", "runner_b_positive_score",
        "runner_a_negative_score", "runner_b_negative_score", "state_match", "score_match",
        "fail_closed_ood_match", "dual_witness_content_match", "dual_witness_replay_match",
        "deterministic_record_match", "differences"
      ],
      "properties": {
        "schema_version": {"const": "10.0.0"},
        "case_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "runner_a_state": {"$ref": "#/$defs/state"},
        "runner_b_state": {"$ref": "#/$defs/state"},
        "effective_state": {"$ref": "#/$defs/state"},
        "runner_a_positive_score": {"type": "number"},
        "runner_b_positive_score": {"type": "number"},
        "runner_a_negative_score": {"type": "number"},
        "runner_b_negative_score": {"type": "number"},
        "state_match": {"type": "boolean"},
        "score_match": {"type": "boolean"},
        "fail_closed_ood_match": {"type": "boolean"},
        "dual_witness_content_match": {"type": "boolean"},
        "dual_witness_replay_match": {"type": "boolean"},
        "deterministic_record_match": {"type": "boolean"},
        "differences": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/difference"}}
      }
    },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator", "estimate", "lower", "upper", "confidence_level", "method"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "estimate": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "lower": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "upper": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "method": {"const": "wilson_score"}
      }
    }
  }
}
