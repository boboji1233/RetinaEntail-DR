{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/stage12-recovery-audit-v12.schema.json",
  "title": "RetinaEntail-DR Stage 12 Local Signer Recovery Audit v12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "method", "scope", "status", "failure_state",
    "source_stage11_package_sha256", "source_stage11_package_file_count", "runner_results",
    "runner_process_ids", "independent_process_count", "physical_host_count",
    "cross_physical_host_tested", "cross_physical_host_claim",
    "signer_adapter_interoperability", "random_ephemeral_private_keys",
    "private_keys_exported", "private_keys_written_to_artifacts", "hsm_backed",
    "trusted_timestamp_service_used", "rfc6960_ocsp_used",
    "local_signed_status_staple_verified", "compromised_generation", "recovered_generation",
    "compromised_keys_rejected_after_revocation", "recovered_runner_comparison",
    "tamper_audit", "production_authentication", "production_ceremony_executed",
    "complete_wheel_archive_hashes", "hardware_identity_attested", "dataset_root_probed",
    "real_data_read_count", "test_split_used_for_tuning", "thresholds_reestimated",
    "sample_replacement_performed", "network_used_during_fixture", "gpu_used",
    "weights_downloaded", "large_model_trained", "clinical_claim"
  ],
  "properties": {
    "schema_version": {"const": "12.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "method": {"const": "two_process_random_ed25519_compromise_recovery_v1"},
    "scope": {"const": "SYNTHETIC_FIXTURE"},
    "status": {"enum": ["SUCCESS", "FAIL_CLOSED"]},
    "failure_state": {"const": "OUT_OF_MODEL"},
    "source_stage11_package_sha256": {"$ref": "#/$defs/sha256"},
    "source_stage11_package_file_count": {"type": "integer", "minimum": 1},
    "runner_results": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "runner_id", "producer_process_id", "session_nonce_sha256", "trust_anchor_sha256",
          "compromised_key_id", "recovered_key_id",
          "pre_compromise_signature_cryptographically_valid",
          "pre_compromise_authority_after_revocation", "recovered_authority", "frozen_payload"
        ],
        "properties": {
          "runner_id": {"type": "string", "minLength": 1},
          "producer_process_id": {"type": "integer", "minimum": 1},
          "session_nonce_sha256": {"$ref": "#/$defs/sha256"},
          "trust_anchor_sha256": {"$ref": "#/$defs/sha256"},
          "compromised_key_id": {"$ref": "#/$defs/sha256"},
          "recovered_key_id": {"$ref": "#/$defs/sha256"},
          "pre_compromise_signature_cryptographically_valid": {"const": true},
          "pre_compromise_authority_after_revocation": {"const": "REJECTED"},
          "recovered_authority": {"const": "ACCEPTED_LOCAL_FIXTURE_ONLY"},
          "frozen_payload": {"$ref": "#/$defs/verifiedPayload"}
        }
      }
    },
    "runner_process_ids": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "independent_process_count": {"const": 2},
    "physical_host_count": {"const": 1},
    "cross_physical_host_tested": {"const": false},
    "cross_physical_host_claim": {"const": false},
    "signer_adapter_interoperability": {"const": "LOCAL_PROTOCOL_FIXTURE_ONLY"},
    "random_ephemeral_private_keys": {"const": true},
    "private_keys_exported": {"const": false},
    "private_keys_written_to_artifacts": {"const": false},
    "hsm_backed": {"const": false},
    "trusted_timestamp_service_used": {"const": false},
    "rfc6960_ocsp_used": {"const": false},
    "local_signed_status_staple_verified": {"const": true},
    "compromised_generation": {"const": 1},
    "recovered_generation": {"const": 2},
    "compromised_keys_rejected_after_revocation": {"const": true},
    "recovered_runner_comparison": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "status", "differences", "effective_state_on_difference",
        "deterministic_difference_fail_closed"
      ],
      "properties": {
        "schema_version": {"const": "12.0.0"},
        "status": {"enum": ["SUCCESS", "FAIL_CLOSED"]},
        "differences": {"type": "array", "items": {"type": "string"}},
        "effective_state_on_difference": {"const": "OUT_OF_MODEL"},
        "deterministic_difference_fail_closed": {"const": true}
      }
    },
    "tamper_audit": {"$ref": "#/$defs/tamperAudit"},
    "production_authentication": {"const": false},
    "production_ceremony_executed": {"const": false},
    "complete_wheel_archive_hashes": {"const": false},
    "hardware_identity_attested": {"const": false},
    "dataset_root_probed": {"const": false},
    "real_data_read_count": {"const": 0},
    "test_split_used_for_tuning": {"const": false},
    "thresholds_reestimated": {"const": false},
    "sample_replacement_performed": {"const": false},
    "network_used_during_fixture": {"const": false},
    "gpu_used": {"const": false},
    "weights_downloaded": {"const": false},
    "large_model_trained": {"const": false},
    "clinical_claim": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifiedPayload": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "runner_id", "producer_process_id", "session_nonce_sha256",
        "phase", "signing_generation", "source_stage11_package_sha256",
        "source_stage11_package_file_count", "source_stage11_manifest_sha256",
        "source_stage11_audit_sha256", "source_stage11_summary_sha256",
        "frozen_contract_sha256", "alpha", "positive_threshold", "negative_threshold",
        "positive_sample_count", "negative_sample_count", "config_hash", "data_hash",
        "model_hash", "scope", "split", "payload_contains_data", "payload_contains_root",
        "payload_contains_private_key", "authorizes_real_data", "authorizes_physical_root",
        "production_authentication"
      ],
      "properties": {
        "schema_version": {"const": "12.0.0"},
        "runner_id": {"type": "string"},
        "producer_process_id": {"type": "integer", "minimum": 1},
        "session_nonce_sha256": {"$ref": "#/$defs/sha256"},
        "phase": {"const": "RECOVERED"},
        "signing_generation": {"const": 2},
        "source_stage11_package_sha256": {"$ref": "#/$defs/sha256"},
        "source_stage11_package_file_count": {"type": "integer", "minimum": 1},
        "source_stage11_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_stage11_audit_sha256": {"$ref": "#/$defs/sha256"},
        "source_stage11_summary_sha256": {"$ref": "#/$defs/sha256"},
        "frozen_contract_sha256": {"$ref": "#/$defs/sha256"},
        "alpha": {"type": "number"},
        "positive_threshold": {"type": "number"},
        "negative_threshold": {"type": "number"},
        "positive_sample_count": {"type": "integer", "minimum": 1},
        "negative_sample_count": {"type": "integer", "minimum": 1},
        "config_hash": {"$ref": "#/$defs/sha256"},
        "data_hash": {"$ref": "#/$defs/sha256"},
        "model_hash": {"$ref": "#/$defs/sha256"},
        "scope": {"const": "LOCAL_RANDOM_EPHEMERAL_PROCESS_ONLY"},
        "split": {"const": "test"},
        "payload_contains_data": {"const": false},
        "payload_contains_root": {"const": false},
        "payload_contains_private_key": {"const": false},
        "authorizes_real_data": {"const": false},
        "authorizes_physical_root": {"const": false},
        "production_authentication": {"const": false}
      }
    },
    "tamperAudit": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "status", "scenario_count", "rejection_count", "results",
        "failure_state", "synthetic_only"
      ],
      "properties": {
        "schema_version": {"const": "12.0.0"},
        "status": {"enum": ["SUCCESS", "FAIL_CLOSED"]},
        "scenario_count": {"const": 10},
        "rejection_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "results": {
          "type": "array", "minItems": 10, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["scenario", "expected_code", "observed_code", "rejected"],
            "properties": {
              "scenario": {"type": "string"},
              "expected_code": {"type": "string"},
              "observed_code": {"type": "string"},
              "rejected": {"type": "boolean"}
            }
          }
        },
        "failure_state": {"const": "OUT_OF_MODEL"},
        "synthetic_only": {"const": true}
      }
    }
  }
}
