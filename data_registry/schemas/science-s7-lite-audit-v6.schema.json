{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/science-s7-lite-audit-v6.schema.json",
  "title": "Science S7 RetinaEntail-Lite v6 audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "config_sha256",
    "development_disclosure",
    "method",
    "source_split",
    "training",
    "preservation",
    "multi_region",
    "development_gate_metrics",
    "resource",
    "io_audit",
    "gate",
    "hashes",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "6.0.0"},
    "experiment_id": {"const": "S7_RETINAENTAIL_LITE_V6"},
    "status": {"enum": ["READY_FOR_AI_QC", "BLOCKED_AUTOMATED_GATE"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "development_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v1_to_v5_observed", "independent_replication", "final_test_opened"],
      "properties": {
        "v1_to_v5_observed": {"const": true},
        "independent_replication": {"const": false},
        "final_test_opened": {"const": false}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "python_version",
        "torch_version",
        "parameter_count",
        "embedding_dim",
        "head_penalty_weight",
        "pretrained_weights",
        "witness_policy"
      ],
      "properties": {
        "runtime": {"const": "PYTHON_3_11_TORCH_2_5_1_CPU"},
        "python_version": {"const": "3.11"},
        "torch_version": {"const": "2.5.1+cpu"},
        "parameter_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "embedding_dim": {"const": 16},
        "head_penalty_weight": {"const": 0.1},
        "pretrained_weights": {"const": false},
        "witness_policy": {"const": "REUSE_V1_POSITIVE_NEGATIVE_BEST_CANDIDATES"}
      }
    },
    "source_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_counts",
        "role_overlap",
        "train_sources_used",
        "train_observations",
        "conformal_rows",
        "validation_rows"
      ],
      "properties": {
        "role_counts": {"type": "object"},
        "role_overlap": {"const": 0},
        "train_sources_used": {"type": "integer", "minimum": 1},
        "train_observations": {"type": "integer", "minimum": 40},
        "conformal_rows": {"type": "integer", "minimum": 1},
        "validation_rows": {"type": "integer", "minimum": 1}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epochs",
        "batch_size",
        "learning_rate",
        "initial_loss",
        "final_loss",
        "minimum_loss",
        "finite"
      ],
      "properties": {
        "epochs": {"const": 100},
        "batch_size": {"const": 32},
        "learning_rate": {"const": 0.001},
        "initial_loss": {"type": "number", "minimum": 0},
        "final_loss": {"type": "number", "minimum": 0},
        "minimum_loss": {"type": "number", "minimum": 0},
        "finite": {"const": true}
      }
    },
    "preservation": {"type": "object"},
    "multi_region": {"type": "object"},
    "development_gate_metrics": {
      "type": "object",
      "required": [
        "validation_fcr",
        "validation_cluster_bootstrap",
        "validation_moderate_glare_determinate_coverage_per_class",
        "validation_lite_verify_shared_in_domain_records",
        "validation_lite_verify_agreement_count",
        "validation_lite_verify_agreement_rate",
        "all_ood_records",
        "all_ood_out_of_model"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "gpu_used", "peak_python_tracemalloc_bytes", "silent_resolution_change"],
      "properties": {
        "device": {"const": "CPU"},
        "gpu_used": {"const": false},
        "peak_python_tracemalloc_bytes": {"type": "integer", "minimum": 0},
        "silent_resolution_change": {"const": false}
      }
    },
    "io_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound_png_decodes",
        "probe_searches_rerun",
        "locked_test_root_reads",
        "online_evaluation_reads",
        "source_split_leaks"
      ],
      "properties": {
        "bound_png_decodes": {"type": "integer", "minimum": 1},
        "probe_searches_rerun": {"const": 0},
        "locked_test_root_reads": {"const": 0},
        "online_evaluation_reads": {"const": 0},
        "source_split_leaks": {"const": 0}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_validation_fcr",
        "minimum_validation_moderate_coverage_per_class",
        "minimum_validation_lite_verify_agreement",
        "automated",
        "ai_visual_qc",
        "s8_authorized"
      ],
      "properties": {
        "maximum_validation_fcr": {"const": 0.05},
        "minimum_validation_moderate_coverage_per_class": {"const": 0.05},
        "minimum_validation_lite_verify_agreement": {"const": 0.5},
        "automated": {"enum": ["PASS", "FAIL"]},
        "ai_visual_qc": {"const": "PENDING"},
        "s8_authorized": {"const": false}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_sha256",
        "model_sha256",
        "results_sha256",
        "roles_sha256",
        "contact_sheet_sha256"
      ],
      "properties": {
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "results_sha256": {"$ref": "#/$defs/sha256"},
        "roles_sha256": {"$ref": "#/$defs/sha256"},
        "contact_sheet_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["HE", "EX", "MA", "SE"],
          "properties": {
            "HE": {"$ref": "#/$defs/sha256"},
            "EX": {"$ref": "#/$defs/sha256"},
            "MA": {"$ref": "#/$defs/sha256"},
            "SE": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "evidence_boundary": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
