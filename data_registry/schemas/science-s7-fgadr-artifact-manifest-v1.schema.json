{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.local/schemas/science-s7-fgadr-artifact-manifest-v1.schema.json",
  "title": "Science S7 FGADR identity-package artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "status", "config_sha256", "archive_sha256", "artifacts", "prohibited_outputs_observed"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"const": "S7_P1_FGADR_IDENTITY_AND_TARGET_MANIFEST_V1"},
    "status": {"const": "PASS_IDENTITY_AND_TARGET_MANIFEST"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "byte_size"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 1}
        }
      }
    },
    "prohibited_outputs_observed": {"type": "array", "maxItems": 0}
  }
}
