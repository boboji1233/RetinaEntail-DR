{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinaentail.example/schemas/science-s3-qc-record-v1.schema.json",
  "title": "RetinaEntail-DR Science S3 controlled-twin pilot QC record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "experiment_id",
    "decision",
    "decision_scope",
    "protocol",
    "responsible_person_confirmation",
    "automated_evidence",
    "ai_review",
    "contact_sheets",
    "rejected_attempts",
    "downstream_authorization",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"const": "S3_HE_EX_TWIN_PILOT_QC_2026_08_25"},
    "experiment_id": {"const": "S3_HE_EX_TWIN_PILOT"},
    "decision": {"const": "PASS"},
    "decision_scope": {"const": "SCIENCE_S3_HE_EX_CONTROLLED_TWIN_PILOT_ONLY"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_mode",
        "advisor_review_packet",
        "advisor_review_packet_sha256"
      ],
      "properties": {
        "review_mode": {"const": "AI_ASSISTED_PLUS_RESPONSIBLE_PERSON_CONFIRMATION"},
        "advisor_review_packet": {"type": "string", "minLength": 1},
        "advisor_review_packet_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "responsible_person_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_name",
        "review_date",
        "exact_response",
        "confirmation_source",
        "confirmation_is_cryptographic_signature"
      ],
      "properties": {
        "reviewer_name": {"type": "string", "minLength": 1},
        "review_date": {"type": "string", "format": "date"},
        "exact_response": {"const": "批准 S3 pilot"},
        "confirmation_source": {"type": "string", "minLength": 1},
        "confirmation_is_cryptographic_signature": {"const": false}
      }
    },
    "automated_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_root",
        "generated_audit_status",
        "generated_audit_sha256",
        "artifact_manifest_sha256",
        "pilot_manifest_sha256",
        "selection_audit_sha256",
        "accepted_rejected_sha256",
        "run_config_sha256",
        "implementation_sha256",
        "accepted_twin_count",
        "rejected_attempt_count",
        "paired_output_count",
        "selection_record_count",
        "locked_test_root_reads",
        "locked_test_mask_decodes",
        "source_split_leaks",
        "schema_contract_review"
      ],
      "properties": {
        "artifact_root": {"type": "string", "minLength": 1},
        "generated_audit_status": {"const": "READY_FOR_RESPONSIBLE_CONFIRMATION"},
        "generated_audit_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "pilot_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "selection_audit_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_rejected_sha256": {"$ref": "#/$defs/sha256"},
        "run_config_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_twin_count": {"const": 40},
        "rejected_attempt_count": {"const": 2},
        "paired_output_count": {"const": 80},
        "selection_record_count": {"const": 8809},
        "locked_test_root_reads": {"const": 0},
        "locked_test_mask_decodes": {"const": 0},
        "source_split_leaks": {"const": 0},
        "schema_contract_review": {"const": "PASS_WITHOUT_THIRD_PARTY_VALIDATOR"}
      }
    },
    "ai_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_sheet_count",
        "reviewed_accepted_twin_count",
        "magnified_case_count",
        "method",
        "overall_finding"
      ],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_sheet_count": {"const": 2},
        "reviewed_accepted_twin_count": {"const": 40},
        "magnified_case_count": {"const": 5},
        "method": {"type": "string", "minLength": 1},
        "overall_finding": {"const": "AI_REVIEW_PASS_WITH_DOCUMENTED_LIMITATIONS"}
      }
    },
    "contact_sheets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/contactSheet"}
    },
    "rejected_attempts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/rejectedAttempt"}
    },
    "downstream_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verify",
        "lite",
        "enhancer_training",
        "locked_test_evaluation",
        "fcr_estimation",
        "paper_performance_experiments"
      ],
      "properties": {
        "verify": {"const": false},
        "lite": {"const": false},
        "enhancer_training": {"const": false},
        "locked_test_evaluation": {"const": false},
        "fcr_estimation": {"const": false},
        "paper_performance_experiments": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkStatus": {"enum": ["PASS", "PASS_WITH_NOTE", "FAIL"]},
    "contactSheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "lesion_class",
        "accepted_twins",
        "decision",
        "checklist",
        "notes"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "lesion_class": {"enum": ["HE", "EX"]},
        "accepted_twins": {"const": 20},
        "decision": {"const": "PASS_WITH_NOTE"},
        "checklist": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_removal_without_visible_residual",
            "sham_target_preserved",
            "non_target_lesions_preserved",
            "no_obvious_seam_or_texture_copy_artifact",
            "patch_and_mask_alignment",
            "no_fov_black_border_contamination"
          ],
          "properties": {
            "target_removal_without_visible_residual": {"$ref": "#/$defs/checkStatus"},
            "sham_target_preserved": {"$ref": "#/$defs/checkStatus"},
            "non_target_lesions_preserved": {"$ref": "#/$defs/checkStatus"},
            "no_obvious_seam_or_texture_copy_artifact": {"$ref": "#/$defs/checkStatus"},
            "patch_and_mask_alignment": {"$ref": "#/$defs/checkStatus"},
            "no_fov_black_border_contamination": {"$ref": "#/$defs/checkStatus"}
          }
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "rejectedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "split", "lesion_class", "method", "reason_code"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["TRAIN", "CALIBRATION"]},
        "lesion_class": {"enum": ["HE", "EX"]},
        "method": {"enum": ["TELEA", "NAVIER_STOKES", "DONOR_POISSON"]},
        "reason_code": {
          "enum": ["TARGET_EDIT_OVERLAPS_OTHER_LESION", "DONOR_LOCATION_UNAVAILABLE"]
        }
      }
    }
  }
}
